# ──────────────────────────────────────────────────────────
# clinic-website — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────────────────

# ── Databases (Clinic & Pharmacy) ────────────────────────
# Clinic Database (PostgreSQL)
DB_URL=jdbc:postgresql://pg-2ec02a9b-eakhalaivanp-46d0.i.aivencloud.com:15783/defaultdb?sslmode=require
# Alternative Local DB: DB_URL=jdbc:postgresql://localhost:5432/clinic?sslmode=disable
DB_USER=avnadmin
DB_PASSWORD=your_db_password
POSTGRES_PASSWORD=your_postgres_password




JWT_SECRET=your_jwt_secret
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=your_twilio_number
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
VITE_API_BASE_URL=http://localhost:8080/api
ALLOWED_ORIGINS=http://localhost:5173
SEED_ADMIN_PASSWORD=your_admin_password
SEED_DOCTOR_PASSWORD=your_doctor_password

# ── Groq AI Configuration ────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Subclinic / Growth Service Integration ────────────────
GROWTH_SERVICE_URL=https://subclinic-website.onrender.com
INTERNAL_GATEWAY_SECRET=clinic-internal-secret-key-2026
# ── JVM Memory Options (Prevents OOM Kills in RAM-constrained containers) ─
JAVA_TOOL_OPTIONS=-Xms96m -Xmx220m -XX:MaxMetaspaceSize=110m -XX:ReservedCodeCacheSize=48m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError


